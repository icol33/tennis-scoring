rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sesi turnamen: siapa pun yang membuka app boleh baca & ubah (tanpa login),
    // tapi bentuk datanya dibatasi supaya tidak bisa diisi sembarangan.
    match /tournaments/{tid} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if validTournament(request.resource.data);

      match /scores/{mid} {
        allow read: if true;
        allow delete: if true;
        allow create, update: if validScore(request.resource.data);
      }
    }

    function validTournament(d) {
      return d.keys().hasAll(['name', 'players', 'matches'])
        && d.keys().hasOnly(['name', 'date', 'sport', 'mode', 'courts', 'status', 'players', 'host',
                             'matches', 'gen', 'createdAt', 'updatedAt', 'scheduledPlayers'])
        && d.name is string && d.name.size() <= 80
        && (!('host' in d) || (d.host is string && d.host.size() <= 60))
        && d.players is list && d.players.size() <= 40
        && d.matches is list && d.matches.size() <= 800
        && (!('mode' in d) || d.mode in ['single', 'double'])
        && (!('courts' in d) || (d.courts is int && d.courts >= 1 && d.courts <= 10));
    }

    function validScore(d) {
      return d.keys().hasOnly(['sa', 'sb', 'active', 'at'])
        && (!('sa' in d) || (d.sa is int && d.sa >= 0 && d.sa <= 99))
        && (!('sb' in d) || (d.sb is int && d.sb >= 0 && d.sb <= 99))
        && (!('active' in d) || d.active is bool);
    }
  }
}
